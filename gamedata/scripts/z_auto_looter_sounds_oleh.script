if z_auto_looter and z_auto_looter.handle_loot then
	handle_loot = z_auto_looter.handle_loot
	function z_auto_looter.handle_loot(actor)
		if itms_manager.timeout_snd_on_take then
			itms_manager.timeout_snd_on_take(50)
			local snd_obj = sound_object([[interface\inv_move_all]])
			snd_obj:play(db.actor,0,sound_object.s2d)
		end
		handle_loot(actor)
	end
end